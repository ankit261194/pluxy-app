# Pluxy Social Super-App Configuration Template
PORT=8080
DATABASE_PATH=data/pluxy.db
ALLOWED_ORIGINS=https://appassets.androidplatform.net,https://pluxy.app

# Google Gemini API Key (Server-Side Secret - Never exposed to client)
GEMINI_API_KEY=AIzaSy_YOUR_REAL_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# WebRTC STUN / TURN Configuration
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.pluxy.app:3478
TURN_USERNAME=pluxy_user
TURN_CREDENTIAL=pluxy_secure_turn_secret

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY_HERE

# Payment / Payout Provider (Razorpay / Stripe)
PAYOUT_PROVIDER=manual_review
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
