# Pluxy Social Super-App .htaccess for Hostinger Shared / Cloud Hosting
# Handles SPA rewrites, PWA headers, security headers, and compression

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Security: Block access to hidden files and SQLite database files
    RewriteRule ^\.git - [F,L]
    RewriteRule ^data/.*\.db$ - [F,L]
    RewriteRule ^backend/ - [F,L]

    # SPA Routing: Redirect all non-file/non-directory requests to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/ws
    RewriteRule ^ index.html [L]
</IfModule>

# MIME types for PWA and Modern Web Assets
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType video/mp4 .mp4
    AddType audio/webm .webm
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "no-referrer-when-downgrade"

    # Disable cache for Service Worker
    <FilesMatch "^(sw\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Gzip Compression for Fast Mobile Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
